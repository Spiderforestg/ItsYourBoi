{
  "name": "Its Your Boi",
  "description": "A Focus Buddy to help you lock in.",
  "version": "1.3",
  "manifest_version": 3,
  "permissions": ["storage", "alarms", "notifications"],

  "background": {
    "service_worker": "src/features/main/background.js",
    "type": "module",
    "scripts": ["src/features/main/background.js"]
  },
  "action": {
    "default_popup": "src/features/main/createPet/createPet.html",
    "default_icon": "src/assets/icon.svg"
  },
  "icons": {
    "48": "src/assets/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@its-your-boi"
    }
  }
}